# Copy to .env and change both secrets. Neither has a default.
#   openssl rand -hex 24   # makes a reasonable value for each
POSTGRES_PASSWORD=change-me
MEMSTORE_API_KEY=change-me

# The user the empty database is created for on first start. One user; this
# example is not a multi-user deployment.
MEMSTORE_DEFAULT_USER=trial

# Embedding model. nomic-embed-text is small enough for CPU. The model is
# recorded on first use and the daemon refuses to start under a different one;
# to switch, stop it, run `memstore admin reset-embeddings --yes`, and start
# again -- every fact is re-embedded from the queue.
EMBEDDING_MODEL=nomic-embed-text

# To use an Ollama already running on the host instead of the bundled one,
# uncomment this and start with `docker compose up -d postgres memstored`.
# host.docker.internal resolves on Docker Desktop; on Linux add
# `extra_hosts: ["host.docker.internal:host-gateway"]` to memstored, or use
# the host's LAN address.
#EMBEDDING_BASE_URL=http://host.docker.internal:11434
